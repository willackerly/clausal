    ((LVocab.sumTooBig main)) := by
  intros
  refine ⟨_, rfl, ?_⟩
  first | (simp_all [LVocab.holds, LVocab.sumTooBig, LVocab.noResult]; done) | (simp_all [LVocab.holds, LVocab.sumTooBig, LVocab.noResult]; scalar_tac) | scalar_tac | exact Classical.em _ | exact (Classical.em _).symm

/-- No input to `ledger.Ledger.balance` falls outside the Givens of all of:
    Spec.ledger.balance_of_account
    Spec.ledger.balance_no_account
-/
theorem Coverage.g7 : ∀ (i : Usize) (main : ledger.Ledger), ∃ (balances : List U64), 
    LVocab.holds main balances ∧
    ((LVocab.isAccount main i) ∨
      (LVocab.notAccount main i)) := by
  intros
  refine ⟨_, rfl, ?_⟩
  first | (simp_all [LVocab.holds, LVocab.isAccount, LVocab.resultIsBalance, LVocab.notAccount, LVocab.noResult]; done) | (simp_all [LVocab.holds, LVocab.isAccount, LVocab.resultIsBalance, LVocab.notAccount, LVocab.noResult]; scalar_tac) | scalar_tac | exact Classical.em _ | exact (Classical.em _).symm

/-- No input to `ledger.Ledger.apply_all` falls outside the Givens of all of:
    Spec.ledger.whole_rejected_unchanged
    Spec.ledger.whole_first_invalid
    Spec.ledger.whole_conserves
-/
theorem Coverage.g8 : ∀ (batch : Slice ledger.Transfer) (main : ledger.Ledger), ∃ (balances : List U64), 
    LVocab.holds main balances ∧
    ((True) ∨
      (LVocab.firstInvalid main batch) ∨
      (True)) := by
  intros
  refine ⟨_, rfl, ?_⟩
  first | (simp_all [LVocab.holds, LVocab.unchangedIfRejected, LVocab.firstInvalid, LVocab.rejected, LVocab.unchanged, LVocab.totalUnchanged]; done) | (simp_all [LVocab.holds, LVocab.unchangedIfRejected, LVocab.firstInvalid, LVocab.rejected, LVocab.unchanged, LVocab.totalUnchanged]; scalar_tac) | scalar_tac | exact Classical.em _ | exact (Classical.em _).symm

/-- No input to `wallet.Wallet.deposit` falls outside the Givens of all of:
    Spec.negative_controls.bystander_unchanged
-/
theorem Coverage.g9 : ∀ (amount : U64) (alice bob : wallet.Wallet), ∃ (a b : U64), 
    Vocab.hasBalance alice a ∧
    Vocab.hasBalance bob b ∧
    ((Vocab.roomFor alice amount)) := by
  intros
  refine ⟨_, _, rfl, rfl, ?_⟩
  first | (simp_all [Vocab.hasBalance, Vocab.roomFor, Vocab.succeeds, Vocab.unchanged]; done) | (simp_all [Vocab.hasBalance, Vocab.roomFor, Vocab.succeeds, Vocab.unchanged]; scalar_tac) | scalar_tac | exact Classical.em _ | exact (Classical.em _).symm


def EvenFn (f : ℝ → ℝ) : Prop := ∀ x, f (-x) = f x

theorem EvenFn.zero : EvenFn (fun _ => 0) := by simp [EvenFn]

theorem EvenFn.neg {f : ℝ → ℝ} (h : EvenFn f) : EvenFn (fun x => - f x) := by
  unfold EvenFn at h ⊢; simp [h]

theorem EvenFn.add {f g : ℝ → ℝ} (hf : EvenFn f) (hg : EvenFn g) : EvenFn (fun x => f x + g x) := by
  unfold EvenFn at hf hg ⊢; simp [hf, hg]

theorem EvenFn.sub {f g : ℝ → ℝ} (hf : EvenFn f) (hg : EvenFn g) : EvenFn (fun x => f x - g x) := by
  unfold EvenFn at hf hg ⊢; simp [hf, hg]

theorem EvenFn.const_mul {f : ℝ → ℝ} (c : ℝ) (hf : EvenFn f) : EvenFn (fun x => c * f x) := by
  unfold EvenFn at hf ⊢; simp [hf]


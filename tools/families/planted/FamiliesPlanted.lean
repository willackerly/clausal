/-
Synthetic families used as controls for the M9 clustering.  Never part of any corpus.
Generated by the script in planted.sh's comment; expected outcomes in planted/expected.json.

  Family A (same body up to one numeral, parallel lemmas):  Decay2, Decay3, Decay5
      `∃ C, 0 ≤ C ∧ ∀ x, |f x| ≤ C / (1 + |x|) ^ n`  with zero / neg / add / const_mul for each.
      Expected: together from level 1 (numerals abstracted) on, one numeral hole, and in the
      body-and-API channel.
  Family B (different bodies, same lemma roles):  EvenFn, PeriodicOne, VanishAtZero
      three unrelated-looking predicates on ℝ → ℝ, each closed under zero / neg / add / sub / const_mul.
      Expected: NOT together by body at levels 0-3; together in the role channel.
  Negative N1: Lonely, a predicate with one lemma and no sibling.  Expected: in no family.
  Coincidence N2: stepAbove, scaleUp, two arithmetic formulas with no shared meaning and no lemmas.
      Expected: clustered at level 1 (the matcher cannot tell meaning); nothing in the lemma channels.
-/
import Mathlib.Analysis.SpecificLimits.Basic

namespace FamiliesPlanted

def Decay2 (f : ℝ → ℝ) : Prop := ∃ C, 0 ≤ C ∧ ∀ x, |f x| ≤ C / (1 + |x|) ^ 2

theorem Decay2.zero : Decay2 (fun _ => 0) := ⟨0, le_rfl, fun x => by simp⟩

theorem Decay2.neg {f : ℝ → ℝ} (h : Decay2 f) : Decay2 (fun x => - f x) := by
  obtain ⟨C, hC, hb⟩ := h
  exact ⟨C, hC, fun x => by simpa using hb x⟩

theorem Decay2.add {f g : ℝ → ℝ} (hf : Decay2 f) (hg : Decay2 g) : Decay2 (fun x => f x + g x) := by
  obtain ⟨C, hC, hb⟩ := hf
  obtain ⟨D, hD, hd⟩ := hg
  refine ⟨C + D, add_nonneg hC hD, fun x => ?_⟩
  calc |f x + g x| ≤ |f x| + |g x| := abs_add_le _ _
    _ ≤ C / (1 + |x|) ^ 2 + D / (1 + |x|) ^ 2 := add_le_add (hb x) (hd x)
    _ = (C + D) / (1 + |x|) ^ 2 := by ring

theorem Decay2.const_mul {f : ℝ → ℝ} (c : ℝ) (hf : Decay2 f) : Decay2 (fun x => c * f x) := by
  obtain ⟨C, hC, hb⟩ := hf
  refine ⟨|c| * C, mul_nonneg (abs_nonneg c) hC, fun x => ?_⟩
  rw [abs_mul, mul_div_assoc]
  exact mul_le_mul_of_nonneg_left (hb x) (abs_nonneg c)


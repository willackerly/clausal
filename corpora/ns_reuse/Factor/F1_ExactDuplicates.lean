/-!
F1. Exact-statement duplicates, whole corpus.

Every cluster of theorems with the same statement (key `kE`) is checked: each member is re-proved
by the single term `@representative`, and the result goes through the kernel.  Then the two
largest clusters are replaced by ONE freshly written lemma each.
-/

set_option maxHeartbeats 400000

#follows_dups "../../out/corpus/reuse/factor/dups.jsonl"

namespace ReuseFactor

/-- Replaces 83 private copies (`nat_le_infty`, `nat_le_smooth`, …) in 82 modules. -/
theorem nat_le_infty (n : ℕ) : (n : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) :=
  WithTop.coe_le_coe.mpr le_top

/-- Replaces 22 local instances in 22 modules. -/
theorem fact_zero_lt_one : Fact ((0 : ℝ) < 1) := ⟨zero_lt_one⟩

end ReuseFactor

#follows_file "nat_le_infty" "../../out/corpus/reuse/factor/nat_le_infty.txt" := ReuseFactor.nat_le_infty
#follows_file "fact_zero_lt_one" "../../out/corpus/reuse/factor/fact_zero_lt_one.txt" := ReuseFactor.fact_zero_lt_one

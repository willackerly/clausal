-- ===== input coverage: do the proved scenarios of one operation cover every input?
/-- No input to `wallet.transfer` falls outside the Givens of all of:
    Spec.wallet.transfer_conserves
    Spec.wallet.transfer_short
    Spec.wallet.transfer_no_room
-/
theorem Coverage.g0 : ∀ (amount : U64) (alice bob : wallet.Wallet), ∃ (a b : U64), 
    Vocab.hasBalance alice a ∧
    Vocab.hasBalance bob b ∧
    ((Vocab.covers alice amount ∧ Vocab.roomFor bob amount) ∨
      (Vocab.exceeds amount alice) ∨
      (Vocab.covers alice amount ∧ Vocab.noRoomFor bob amount)) := by
  intros
  refine ⟨_, _, rfl, rfl, ?_⟩
  first | (simp_all [Vocab.hasBalance, Vocab.covers, Vocab.roomFor, Vocab.succeeds, Vocab.decreasedBy, Vocab.increasedBy, Vocab.totalUnchanged, Vocab.exceeds, Vocab.rejectedWith, Vocab.unchanged, Vocab.noRoomFor]; done) | (simp_all [Vocab.hasBalance, Vocab.covers, Vocab.roomFor, Vocab.succeeds, Vocab.decreasedBy, Vocab.increasedBy, Vocab.totalUnchanged, Vocab.exceeds, Vocab.rejectedWith, Vocab.unchanged, Vocab.noRoomFor]; scalar_tac) | scalar_tac | exact Classical.em _ | exact (Classical.em _).symm


-- ===== Rule.ledger.lookup
/-- The scenarios beneath the rule, together, entail the rule statement. -/
theorem Rule.ledger.lookup.from_scenarios : Spec.ledger.balance_of_account.reading → Spec.ledger.balance_no_account.reading → Rule.ledger.lookup.reading := by
  intro s1 s2
  · intro st inp sc
    by_cases k1 : (L.isAccount st inp)
    · obtain ⟨r, s', e, qc1_1⟩ := (s1 _) st inp ⟨trivial, rfl, k1⟩
      exact ⟨r, s', e, by bridge⟩
    · by_cases k2 : (¬ ((L.isAccount st inp)))
      · obtain ⟨r, s', e, qc2_1⟩ := (s2 _) st inp ⟨trivial, rfl, k2⟩
        exact ⟨r, s', e, by bridge⟩
      · exfalso; bridge

/-- The rule statement holds for every input: from its scenarios, each proved. -/
theorem Rule.ledger.lookup.holds : Rule.ledger.lookup.reading := Rule.ledger.lookup.from_scenarios Spec.ledger.balance_of_account.reading_holds Spec.ledger.balance_no_account.reading_holds

-- ===== Rule.ledger.whole_batch
/-- The scenarios beneath the rule, together, entail the rule statement. -/
theorem Rule.ledger.whole_batch.from_scenarios : Spec.ledger.whole_rejected_unchanged.reading → Spec.ledger.whole_first_invalid.reading → Spec.ledger.whole_conserves.reading → Rule.ledger.whole_batch.reading := by
  intro s1 s2 s3
  refine ⟨?_, ?_⟩
  · intro st inp sc
    intro r0 s0 e0 hm
    obtain ⟨r, s', e, qa0_1⟩ := (s1 _).1 st inp ⟨trivial, rfl⟩
    have qa0_2 := (s1 _).2 st inp ⟨trivial, rfl⟩ r s' e
    obtain ⟨r2, s2, e2, qa1_1⟩ := (s3 _) st inp ⟨trivial, rfl⟩
    obtain ⟨u1, u2⟩ := Frames.Op.answer_unique e e2; subst u1 u2; clear e2
    by_cases k1 : (Frames.theFirst ((L.transfers inp)) (fun x => (¬ ((L.valid st x)))))
    · obtain ⟨r2, s2, e2, qc1_1⟩ := (s2 _).1 st inp ⟨trivial, rfl, k1⟩
      obtain ⟨u1, u2⟩ := Frames.Op.answer_unique e e2; subst u1 u2; clear e2
      obtain ⟨r2, s2, e2, qc1_2⟩ := (s2 _).2 st inp ⟨trivial, rfl, k1⟩
      obtain ⟨u1, u2⟩ := Frames.Op.answer_unique e e2; subst u1 u2; clear e2
      obtain ⟨u1, u2⟩ := Frames.Op.answer_unique e0 e; subst u1 u2; bridge
    · obtain ⟨u1, u2⟩ := Frames.Op.answer_unique e0 e; subst u1 u2; bridge
  · intro st inp sc
    obtain ⟨r, s', e, qa0_1⟩ := (s1 _).1 st inp ⟨trivial, rfl⟩
    have qa0_2 := (s1 _).2 st inp ⟨trivial, rfl⟩ r s' e
    obtain ⟨r2, s2, e2, qa1_1⟩ := (s3 _) st inp ⟨trivial, rfl⟩
    obtain ⟨u1, u2⟩ := Frames.Op.answer_unique e e2; subst u1 u2; clear e2
    by_cases k1 : (Frames.theFirst ((L.transfers inp)) (fun x => (¬ ((L.valid st x)))))
    · obtain ⟨r2, s2, e2, qc1_1⟩ := (s2 _).1 st inp ⟨trivial, rfl, k1⟩
      obtain ⟨u1, u2⟩ := Frames.Op.answer_unique e e2; subst u1 u2; clear e2
      obtain ⟨r2, s2, e2, qc1_2⟩ := (s2 _).2 st inp ⟨trivial, rfl, k1⟩
      obtain ⟨u1, u2⟩ := Frames.Op.answer_unique e e2; subst u1 u2; clear e2
      exact ⟨r, s', e, by bridge⟩
    · exact ⟨r, s', e, by bridge⟩


-- ===== Spec.ledger_rules.f_other_account_untouched
/-- The compiled reading says exactly what its flat proof obligation says. -/
theorem Spec.ledger_rules.f_other_account_untouched.reading_iff_obligation : Spec.ledger_rules.f_other_account_untouched.reading ↔ Spec.ledger_rules.f_other_account_untouched.obligation := by
  have run0 : ∀ (st : ledger.Ledger) (inp : ledger.Transfer) (ans : Bool) (st' : ledger.Ledger), (L.apply).run st inp = some (ans, st') ↔ (ledger.Ledger.apply st inp = ok (ans, st')) := fun st inp ans st' => Bdd.opMut_some
  constructor
  · intro h
    · intro balances k st inp g1
      have sc : ((L.apply).given (fun st inp => (L.balances st) = balances)).scope st inp := ⟨trivial, g1⟩
      obtain ⟨ans, st', e, q0⟩ := (h balances k).1 st inp sc
      have q1 := (h balances k).2.1 st inp sc ans st' e
      have q2 := (h balances k).2.2 st inp sc ans st' e
      exact ⟨ans, st', (run0 st inp ans st').mp e, q0, q1, q2⟩
  · intro h
    have o0 := h
    intro balances k
    refine ⟨?_, ?_, ?_⟩
    · intro st inp sc
      obtain ⟨-, c1⟩ := sc
      obtain ⟨ans, st', x, q0, q1, q2⟩ := o0 balances k st inp c1
      exact ⟨ans, st', (run0 st inp ans st').mpr x, q0⟩
    · intro st inp sc r0 s0 e0 hm
      obtain ⟨-, c1⟩ := sc
      obtain ⟨ans, st', x, q0, q1, q2⟩ := o0 balances k st inp c1
      obtain ⟨u1, u2⟩ := Frames.Op.answer_unique ((run0 st inp ans st').mpr x) e0; subst u1 u2

-- ===== Rule.ledger.single_transfer
/-- The compiled reading says exactly what its flat proof obligation says. -/
theorem Rule.ledger.single_transfer.reading_iff_obligation : Rule.ledger.single_transfer.reading ↔ Rule.ledger.single_transfer.obligation := by
  have run0 : ∀ (st : ledger.Ledger) (inp : ledger.Transfer) (ans : Bool) (st' : ledger.Ledger), (L.apply).run st inp = some (ans, st') ↔ (ledger.Ledger.apply st inp = ok (ans, st')) := fun st inp ans st' => Bdd.opMut_some
  have run1 : ∀ (st : ledger.Ledger) (inp : ledger.Transfer) (ans : Bool) (st' : ledger.Ledger), (L.apply).run st inp = some (ans, st') ↔ (ledger.Ledger.apply st inp = ok (ans, st')) := fun st inp ans st' => Bdd.opMut_some
  have run2 : ∀ (st : ledger.Ledger) (inp : ledger.Transfer) (ans : Bool) (st' : ledger.Ledger), (L.apply).run st inp = some (ans, st') ↔ (ledger.Ledger.apply st inp = ok (ans, st')) := fun st inp ans st' => Bdd.opMut_some
  constructor
  · intro h
    refine ⟨?_, ?_, ?_⟩
    · intro st inp
      have sc : (L.apply).scope st inp := trivial
      obtain ⟨ans, st', e, q0⟩ := h.1 st inp sc
      exact ⟨ans, st', (run0 st inp ans st').mp e, q0⟩
    · intro st inp
      have sc : (L.apply).scope st inp := trivial
      intro ans st' x
      have e : (L.apply).run st inp = some (ans, st') := (run1 st inp ans st').mpr x
      exact h.2.1 st inp sc ans st' e
    · intro st inp
      have sc : (L.apply).scope st inp := trivial
      intro ans st' x
      have e : (L.apply).run st inp = some (ans, st') := (run2 st inp ans st').mpr x
      exact ⟨h.2.2.1 st inp sc ans st' e, h.2.2.2.1 st inp sc ans st' e, h.2.2.2.2 st inp sc ans st' e⟩
  · intro h
    obtain ⟨o0, o1, o2⟩ := h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro st inp sc
      clear sc
      obtain ⟨ans, st', x, q0⟩ := o0 st inp
      exact ⟨ans, st', (run0 st inp ans st').mpr x, q0⟩
    · intro st inp sc r0 s0 e0 hm
      clear sc
      exact (o1 st inp r0 s0 ((run1 st inp r0 s0).mp e0)) hm
    · intro st inp sc r0 s0 e0 hm
      clear sc
      exact (o2 st inp r0 s0 ((run2 st inp r0 s0).mp e0)).1 hm
    · intro st inp sc r0 s0 e0 hm
      clear sc
      exact (o2 st inp r0 s0 ((run2 st inp r0 s0).mp e0)).2.1 hm
    · intro st inp sc r0 s0 e0 hm
      clear sc
      exact (o2 st inp r0 s0 ((run2 st inp r0 s0).mp e0)).2.2 hm


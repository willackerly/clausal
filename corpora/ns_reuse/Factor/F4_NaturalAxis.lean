import NavierStokes.NaturalAxisRange
import ReuseCheck

/-!
F4. A parameter range proved twice.

`NavierStokes/NaturalAxisData.lean` proves its lemmas for `SmallParameters h j` (h, j ≤ 1/1000);
`NavierStokes/NaturalAxisRange.lean` introduces the wider `Parameters h j` (h ≤ 1/100, j ≤ 1/20),
proves `ofSmall : SmallParameters h j → Parameters h j`, and then proves the lemmas AGAIN by
copying the proofs.  For every pair of theorems whose statement and proof agree up to renaming
(key `svP`) we try to obtain the `SmallParameters` version from the `Parameters` version through
`ofSmall`.  Pairs whose conclusions differ in a numerical constant are expected to fail, and are
reported as failures.
-/

set_option linter.unusedTactic false
set_option linter.unreachableTactic false

open NavierStokes NavierStokes.NaturalAxisRange

#follows "naturalAxis" ["NavierStokes.NaturalAxisData.A_bounds"] :=

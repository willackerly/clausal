  -- kernel-checked. proof: 104 nodes originally, 39 after lifting 2 lemma(s); chosen among 10 candidates

lemma Rev.letdep.lifted_1 :
    ∀ (n : ℕ),
      let m := n + n;
      0 < m → ∃ m, m = n + n ∧ 0 < m ∧ m ≠ 1

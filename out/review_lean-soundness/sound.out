theorem Rev.letdep.lifted : ∀ (n : ℕ), 0 < n → ∃ m, m = n + n ∧ 0 < m ∧ m ≠ 1 :=
fun n h =>
  let m := n + n;
  have hm := Rev.letdep.lifted_2 n h;
  Rev.letdep.lifted_1 n hm

/-- N1: no sibling. -/
def Lonely (f : ℝ → ℝ) : Prop := ∃ x, f x = 1 ∧ ∀ y, f y ≤ f x

theorem Lonely.nonneg_somewhere {f : ℝ → ℝ} (h : Lonely f) : ∃ x, 0 ≤ f x := by
  obtain ⟨x, hx, _⟩ := h
  exact ⟨x, by rw [hx]; norm_num⟩

/-- N2: two formulas with no shared meaning. -/
def stepAbove (n : ℕ) : ℕ := 80 * n + 1
def scaleUp (n : ℕ) : ℕ := 3 * n + 7

end FamiliesPlanted
